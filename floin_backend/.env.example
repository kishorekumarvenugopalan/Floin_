# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS. For Supabase use the session pooler or direct connection string
# from Project Settings -> Database. postgresql:// is rewritten to the psycopg 3 driver.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Raster storage backend: "supabase" (production) or "local" (development; same bucket layout on disk)
STORAGE_BACKEND=supabase
LOCAL_STORAGE_DIR=data/storage

# Supabase project. The service-role key is server-side only: never send it to a frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=floin-rasters

# Model grid (UTM zone 44N, metres)
MODEL_CRS=EPSG:32644
MODEL_RESOLUTION_M=30
