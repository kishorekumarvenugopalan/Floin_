{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "floin-api",
      "runtimeExecutable": "floin_backend/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "floin_backend", "--port", "8000", "--reload", "--reload-dir", "floin_backend/app"],
